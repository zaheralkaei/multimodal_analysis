# ---- Vision backend (phase 2): OpenRouter (default) ----
# Get a key at https://openrouter.ai/keys  (credit at https://openrouter.ai/credits)
OPENROUTER_API_KEY=your-key-here

# Vision model used by phase 2 (OpenRouter slug). google/gemma-4-31b-it is a
# dense multimodal model (text+image in, text out), 256K context, $0.20/M
# input + $0.40/M output (2026-10-19; `python scripts/preflight.py --online` for live).
# Alternatives: google/gemma-4-31b-it:free, google/gemma-3-27b-it, meta-llama vision models, ...
# Browse: https://openrouter.ai/models?output_modalities=text&input_modalities=image
VISION_MODEL=google/gemma-4-31b-it

# Phase 2 budget cap in USD (abort if the estimate exceeds it; stop calling
# once the spend OpenRouter reports reaches it). Default 1.0.
# VISION_MAX_USD=1.0

# Optional override of the OpenRouter endpoint (default below)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Audio stack (round 11): heavy models on hosted services ----
# Each is optional: without a key the pipeline uses a local/free fallback.
# FAL_KEY=your-key-here               # vocal separation, fal.ai Demucs (~$0.0007/s)
# GROQ_API_KEY=your-key-here          # transcription, Groq whisper-large-v3-turbo (~$0.04/h)
# REPLICATE_API_TOKEN=your-key-here   # labelled song sections, All-In-One (~$0.11/run)
# AUDIO_MAX_USD=1.0                   # cap on estimated audio-service spend per video

# ---- Vision backend (phase 2): Ollama (fallback; used when
#      OPENROUTER_API_KEY is unset or --provider ollama is passed) ----
# OLLAMA_API_KEY=your-key-here          # only for Ollama cloud (ollama.com)
# OLLAMA_BASE_URL=http://localhost:11434/api   # or https://ollama.com/api