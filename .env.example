# ---- Vision backend (phase 2): OpenRouter (default) ----
# Get a key at https://openrouter.ai/keys  (credit at https://openrouter.ai/credits)
OPENROUTER_API_KEY=your-key-here

# Vision model used by phase 2 (OpenRouter slug). google/gemma-4-31b-it is a
# dense multimodal model (text+image in, text out), 256K context, ~$0.09/M
# input + $0.34/M output; a :free tier with rate limits exists.
# Alternatives: google/gemma-4-31b-it:free, google/gemma-3-27b-it, meta-llama vision models, ...
# Browse: https://openrouter.ai/models?output_modalities=text&input_modalities=image
VISION_MODEL=google/gemma-4-31b-it

# Optional override of the OpenRouter endpoint (default below)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Vision backend (phase 2): Ollama (fallback; used when
#      OPENROUTER_API_KEY is unset or --provider ollama is passed) ----
# OLLAMA_API_KEY=your-key-here          # only for Ollama cloud (ollama.com)
# OLLAMA_BASE_URL=http://localhost:11434/api   # or https://ollama.com/api